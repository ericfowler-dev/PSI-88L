# Copy to .env for local development. Never commit .env or live credentials.
DATA_DIR=.data
WORKER_MODE=embedded
# Optional initially; configure the AI connection in Settings instead.
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=

# Production requires PostgreSQL, private object storage, and strong secrets.
# DATABASE_URL=postgresql://user:password@host/database
# APP_URL=https://your-assigned-service.onrender.com
# APP_SECRET=generate-at-least-32-random-characters
# SETUP_TOKEN=generate-a-different-random-setup-token
# WORKER_MODE=external
# S3_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=psi-88l-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# OCR_CACHE_DIR=/tmp/psi-ocr

# Only for a deliberately persistent single-process local production preview:
# ALLOW_LOCAL_STORAGE=true
# Only when explicitly connecting a trusted local AI endpoint:
# ALLOW_LOCAL_AI=true
